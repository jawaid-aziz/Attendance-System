# MongoDB connection string (the one used at runtime)
MONGO_URL=mongodb://localhost:27017/onTime
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/onTime?retryWrites=true&w=majority

# MUST be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

# Company timezone used by the public /attend/server-time endpoint
TIMEZONE=Asia/Karachi

# Allowed router IPs for the seed (dev only)
ALLOWED_ROUTER_IPS=192.168.1.1

# Office schedule for the seed (dev only)
OFFICE_SCHEDULE={"Monday":{"isOpen":true,"startTime":"10:00","endTime":"18:00"},"Tuesday":{"isOpen":true,"startTime":"10:00","endTime":"18:00"},"Wednesday":{"isOpen":true,"startTime":"10:00","endTime":"18:00"},"Thursday":{"isOpen":true,"startTime":"10:00","endTime":"18:00"},"Friday":{"isOpen":true,"startTime":"10:00","endTime":"18:00"},"Saturday":{"isOpen":false,"startTime":"09:00","endTime":"17:00"},"Sunday":{"isOpen":false,"startTime":"09:00","endTime":"17:00"}}

# SMTP (Gmail app passwords: https://support.google.com/accounts/answer/185833)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password
# Optional: sender shown on emails. Defaults to "onTime <EMAIL_USER>"
# EMAIL_FROM="onTime <no-reply@example.com>"
# Set to "true" to skip sending emails (prints instead)
# SKIP_EMAIL=false

# Frontend origin used in emailed setup links
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins for the API
CLIENT_ORIGIN=http://localhost:5173

# IP enforcement for check-in/out. "strict" blocks clients whose IP is not in
# the company's allowedRouterIPs; any other value logs and allows (recommended
# for cloud deployments where staff connect through public/NAT IPs).
# IP_ENFORCEMENT=off

# Enable the hourly absent-marking cron on EXACTLY ONE worker instance.
# CRON_ENABLED=true

# Seed (dev only): refuse to run when NODE_ENV=production unless overridden.
# NODE_ENV=development
# SEED_ALLOWED=false
